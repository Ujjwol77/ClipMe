# Shared reference for all the environment variables used across web/, api/ and worker/.
# Each app also has its own .env.example with just the variables it needs - copy that
# one to .env (api, worker) or .env.local (web) in each directory.

# ---- Supabase project (create one at https://supabase.com/dashboard) ----
# Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...               # safe to expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...       # server-side only, never ship to the browser
SUPABASE_JWT_SECRET=...                # Project Settings -> API -> JWT Secret

# Project Settings -> Database -> Connection string (use the "URI" / session pooler
# connection string; the API and worker both connect directly to Postgres)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

STORAGE_BUCKET=clipme-media

# ---- LLM clip selection (optional - omit LLM_API_KEY to use manual timestamp mode) ----
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Limits ----
MAX_SOURCE_DURATION_SECONDS=1800
MAX_UPLOAD_SIZE_BYTES=2147483648
MIN_CLIP_SECONDS=25
MAX_CLIP_SECONDS=75
TARGET_MIN_CLIP_SECONDS=30
TARGET_MAX_CLIP_SECONDS=60
MAX_CLIPS=5

# ---- Frontend-only ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STORAGE_BUCKET=clipme-media
NEXT_PUBLIC_MAX_UPLOAD_SIZE_BYTES=2147483648
NEXT_PUBLIC_MIN_CLIP_SECONDS=25
NEXT_PUBLIC_MAX_CLIP_SECONDS=75
